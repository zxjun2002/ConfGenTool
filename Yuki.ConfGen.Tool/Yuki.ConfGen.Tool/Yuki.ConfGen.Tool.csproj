<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>

    <!-- 关键：声明为 dotnet tool -->
    <PackAsTool>true</PackAsTool>
    <!-- 命令名（运行时敲的命令，建议全小写+短横线） -->
    <ToolCommandName>yuki-confgen</ToolCommandName>
    <!-- 包 ID（安装/卸载/更新都用这个名字） -->
    <PackageId>zxjun2002.ConfGen.Tool</PackageId>
    <Version>1.0.1</Version>
    <Authors>Yuki</Authors>
    <Company>Yuki</Company>
    <Description>Config generator (code + .bytes)</Description>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="30.0.1" />
    <PackageReference Include="ExcelDataReader" Version="3.6.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.6.0" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <Compile Include="..\Shared\Generated\Conf\**\*.cs"
            Link="Generated\%(RecursiveDir)%(Filename)%(Extension)">
    </Compile> 
  </ItemGroup>
</Project>
